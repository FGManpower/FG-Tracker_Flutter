/* Permission texts shown by iOS (Tamil) */
"NSCameraUsageDescription" = "வீடியோ அழைப்புகள், QR குறியீடுகளை ஸ்கேன் செய்தல் மற்றும் வருகையைப் பதிவுசெய்ய நேரலை செல்ஃபி எடுத்தல் ஆகியவற்றுக்கு FG Tracker கேமராவைப் பயன்படுத்துகிறது.";
"NSContactsUsageDescription" = "நபர்களைக் கண்டறிய, இணைய மற்றும் உங்கள் கண்காணிப்புக் குழுக்களில் சேர அழைக்க FG Tracker உங்கள் தொடர்புகளைப் பயன்படுத்துகிறது.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "வருகைப்பதிவு, நேரலைக் கண்காணிப்பு மற்றும் பாதுகாப்பு மண்டல எச்சரிக்கைகளுக்காக, ஆப் பின்னணியில் இருக்கும்போதும் FG Tracker உங்கள் இருப்பிடத்தைப் பயன்படுத்துகிறது; இதனால் உங்கள் குழு எப்போதும் உங்கள் தற்போதைய இடத்தைப் பார்க்க முடியும்.";
"NSLocationAlwaysUsageDescription" = "கண்காணிப்பு அமர்வின்போது ஆப் பின்னணியில் இருந்தாலும் குழு உறுப்பினர்களுக்குத் தகவல் அளிக்க உங்கள் இருப்பிடம் பயன்படுத்தப்படுகிறது.";
"NSLocationWhenInUseUsageDescription" = "வருகைப்பதிவு, உங்கள் குழுவுடன் நேரலைக் கண்காணிப்பு மற்றும் பாதுகாப்பு மண்டல எச்சரிக்கைகளுக்காக FG Tracker உங்கள் இருப்பிடத்தைப் பயன்படுத்துகிறது.";
"PreciseLocation" = "துல்லியமான வருகைப்பதிவு, நேரலைக் கண்காணிப்பு மற்றும் பாதுகாப்பு மண்டல எச்சரிக்கைகளுக்குத் துல்லியமான இருப்பிடம் தேவை.";
"NSMicrophoneUsageDescription" = "ஆடியோ அழைப்புகள், வாக்கி-டாக்கி சேனலில் நேரலைக் குரலை அனுப்புதல் அல்லது திரைப் பகிர்வுக்கு மைக்ரோஃபோன் அணுகல் தேவை.";
"NSSpeechRecognitionUsageDescription" = "உங்கள் குரலால் செய்திகளைத் தட்டச்சு செய்ய பேச்சு அறிதல் அணுகல் தேவை.";
"NSBluetoothAlwaysUsageDescription" = "வாக்கி-டாக்கி மற்றும் குரல் அழைப்புகளின்போது வயர்லெஸ் இயர்ஃபோன்கள் மற்றும் ஹெட்செட்களுடன் இணைக்க FG Tracker-க்கு புளூடூத் அணுகல் தேவை.";
"NSBluetoothPeripheralUsageDescription" = "வயர்லெஸ் இயர்ஃபோன்கள் மற்றும் ஹெட்செட்களுக்கு ஆடியோவை அனுப்ப FG Tracker-க்கு புளூடூத் அணுகல் தேவை.";
"NSPhotoLibraryAddUsageDescription" = "QR குறியீடுகளை உங்கள் கேலரியில் சேமிக்க எங்களுக்கு அணுகல் தேவை.";
"NSPhotoLibraryUsageDescription" = "சுயவிவரப் படத்தை அமைக்க, புகைப்படங்களைப் பதிவேற்ற மற்றும் உங்கள் தள இருப்பிடத்தின் QR குறியீட்டைப் புகைப்பட நூலகத்திலிருந்து பெற எங்களுக்கு உங்கள் புகைப்பட நூலக அணுகல் தேவை.";
